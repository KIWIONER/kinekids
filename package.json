{
  "name": "kinekids-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "uis/frontend",
    "uis/backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "npm run dev:frontend & npm run dev:backend",
    "dev:frontend": "npm run --prefix uis/frontend dev",
    "dev:backend": "npm run --prefix uis/backend dev",
    "build:frontend": "npm run --prefix uis/frontend build",
    "build:backend": "npm run --prefix uis/backend build",
    "lint": "npm run --prefix uis/frontend lint && npm run --prefix uis/backend lint"
  }
}
