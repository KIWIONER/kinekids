{
  "name": "KineKids - Master Gateway & Automation Engine (Gemini + WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kinekids-sync",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e0a1f180-60b7-4cb2-817a-0a1b2c3d4e5f",
      "name": "KineKids-Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        340
      ],
      "webhookId": "kinekids-sync"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $headers[\"x-kinekids-secret\"] || $headers[\"X-KineKids-Secret\"] }}",
              "value2": "={{ $env.KINEKIDS_N8N_SECRET || \"kinekids_n8n_secret_token_2026\" }}"
            }
          ]
        }
      },
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Auth-Validator",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        340
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.body.action }}",
                    "value2": "sync_catalog"
                  }
                ]
              },
              "outputKey": "sync_catalog"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.body.action }}",
                    "value2": "create_order"
                  }
                ]
              },
              "outputKey": "create_order"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
      "name": "Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        640,
        340
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "prompt": "=Traduce y adapta la siguiente ficha de producto infantil al español neutro con enfoque pedagógico Montessori/Pikler para KineKids.\n\nTítulo Original: {{ $json.body.payload.title }}\nDescripción Original: {{ $json.body.payload.description }}\n\nDevuelve una descripción atractiva, serena y estructurada destacando el beneficio en psicomotricidad y juego autónomo.",
        "options": {}
      },
      "id": "c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f",
      "name": "Translate-Catalog",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [
        900,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// Regla de Pricing KineKids: Margen neto >= 20% con portes incluidos\nconst item = $json.body.payload || {};\nconst cost = Number(item.wholesale_price || item.price || 0);\n\nlet multiplier = 1.45;\nif (cost < 20) multiplier = 2.5;\nelse if (cost <= 80) multiplier = 1.8;\n\nconst rawRetail = cost * multiplier;\nconst retailPrice = Math.round(rawRetail / 5) * 5;\n\n// Extraer texto generado por Google Gemini\nconst geminiText = $node[\"Translate-Catalog\"].json?.candidates?.[0]?.content?.parts?.[0]?.text \n  || $node[\"Translate-Catalog\"].json?.text \n  || item.description \n  || \"\";\n\nreturn {\n  id: String(item.id),\n  title: item.title,\n  price: retailPrice,\n  wholesale_price: cost,\n  description: geminiText,\n  image_url: item.imageUrl || item.image_url || \"\",\n  category: item.category || \"module\",\n  age_range: item.ageRange || \"6 meses - 4 años\",\n  dimensions: item.dimensions || \"Medida estándar\",\n  sort_order: 100\n};"
      },
      "id": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a",
      "name": "Calculate-Margin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        220
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "tableId": "products",
        "data": {
          "id": "={{ $json.id }}",
          "title": "={{ $json.title }}",
          "price": "={{ $json.price }}",
          "wholesale_price": "={{ $json.wholesale_price }}",
          "description": "={{ $json.description }}",
          "image_url": "={{ $json.image_url }}",
          "category": "={{ $json.category }}",
          "age_range": "={{ $json.age_range }}",
          "dimensions": "={{ $json.dimensions }}",
          "sort_order": "={{ $json.sort_order }}"
        }
      },
      "id": "e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b",
      "name": "Save-Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1380,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hertwill.com/v1/orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body.payload.order) }}",
        "options": {}
      },
      "id": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c",
      "name": "Hertwill-Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        460
      ]
    },
    {
      "parameters": {
        "operation": "sendText",
        "recipientPhoneNumber": "={{ $json.body.payload.order?.customer?.phone || $env.ADMIN_WHATSAPP_PHONE || \"+34600000000\" }}",
        "textBody": "=📦 *¡Nuevo Pedido KineKids Tramitado!*\n\n• *ID Pedido:* {{ $json.body.payload.order?.order_id || \"N/A\" }}\n• *Cliente:* {{ $json.body.payload.order?.shipping_address?.name || \"Cliente KineKids\" }}\n• *Estado Hertwill:* {{ $json.status || 200 }}\n• *Tracking Ref:* {{ $json.data?.id || \"En preparación...\" }}",
        "additionalFields": {}
      },
      "id": "07b8c9d0-e1f2-4a3b-4c5d-6e7f8a9b0c1d",
      "name": "WhatsApp-Alert",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1140,
        460
      ]
    }
  ],
  "connections": {
    "KineKids-Webhook": {
      "main": [
        [
          {
            "node": "Auth-Validator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auth-Validator": {
      "main": [
        [
          {
            "node": "Router",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Router": {
      "main": [
        [
          {
            "node": "Translate-Catalog",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Hertwill-Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Translate-Catalog": {
      "main": [
        [
          {
            "node": "Calculate-Margin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate-Margin": {
      "main": [
        [
          {
            "node": "Save-Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hertwill-Order": {
      "main": [
        [
          {
            "node": "WhatsApp-Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}